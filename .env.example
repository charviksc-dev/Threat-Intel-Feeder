# ─── Environment Configuration ───────────────────────────────────
# Copy this file to .env and fill in real values

# Application
APP_ENV=production
APP_NAME=Neev Threat Intelligence API
SECRET_KEY=<GENERATE: python3 -c "import secrets; print(secrets.token_urlsafe(64))">
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
ACCESS_TOKEN_EXPIRE_SECONDS=3600
ALLOWED_ORIGINS=http://localhost:4173,http://127.0.0.1:4173
JWT_ISSUER=neev-tip
FRONTEND_URL=http://localhost:4173

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Real-time Features
REDIS_STREAM_ENABLED=true

# Webhook Authentication (SIEM tools must send this in X-Webhook-Token header)
WEBHOOK_AUTH_TOKEN=<GENERATE: python3 -c "import secrets; print(secrets.token_hex(32))">

# PostgreSQL
POSTGRES_USER=neev
POSTGRES_PASSWORD=<CHANGE-ME-strong-password>
POSTGRES_DB=neev
POSTGRES_DSN=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# Redis
REDIS_URL=redis://redis:6379/0

# Elasticsearch
ELASTICSEARCH_HOST=http://elasticsearch:9200
ELASTICSEARCH_INDEX=neev-indicators
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=<CHANGE-ME-strong-es-password>

# ─── OAuth Providers (Optional) ─────────────────────────────────────
# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4173/auth/callback/google

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:4173/auth/callback/github

# Microsoft OAuth
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:4173/auth/callback/microsoft
MICROSOFT_TENANT_ID=common

# ─── Threat Feed API Keys ─────────────────────────────────────────
# OTX (AlienVault)
OTX_API_KEY=<GET FROM: https://otx.alienvault.com/api>

# Abuse.ch (legacy CSV feed)
ABUSECH_FEED_URL=

# MISP
MISP_API_URL=
MISP_API_KEY=

# VirusTotal
VIRUSTOTAL_API_KEY=<GET FROM: https://www.virustotal.com/gui/my-apikey>
MAX_VT_REQUESTS_PER_MINUTE=4

# ─── Feed Toggles (Free feeds, no API key required) ───────────────
URLHAUS_ENABLED=true
THREATFOX_ENABLED=true
FEODO_TRACKER_ENABLED=true
EMERGING_THREATS_ENABLED=true
OPENPHISH_ENABLED=true
PHISHTANK_ENABLED=true
SPAMHAUS_ENABLED=true

# ─── Additional Enrichment Services ───────────────────────────────
# GreyNoise
GREYNOISE_API_KEY=

# Have I Been Pwned
HIBP_API_KEY=
HIBP_MONITORED_EMAILS=

# Hybrid Analysis
HYBRID_ANALYSIS_API_KEY=

# ipinfo.io (passive DNS)
IPINFO_API_KEY=

# ─── SIEM Tool Integrations ────────────────────────────────────────
# TheHive
THEHIVE_URL=http://your-thehive-instance:9000
THEHIVE_API_KEY=<YOUR_THEHIVE_API_KEY>

# Cortex
CORTEX_URL=http://your-cortex-instance:9001
CORTEX_API_KEY=<YOUR_CORTEX_API_KEY>

# Neo4j (Relationship Graph - Optional)
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=

# ─── Notification Integrations ────────────────────────────────────
# Slack Webhook
SLACK_WEBHOOK_URL=

# Generic Alert Webhook
ALERT_WEBHOOK_URL=

# ─── Firewall Integrations (SOAR Containment) ─────────────────────
# Wazuh
WAZUH_URL=https://your-wazuh-instance:55000
WAZUH_API_TOKEN=<YOUR_WAZUH_JWT_TOKEN>
WAZUH_AGENT_ID=
WAZUH_DURATION_HOURS=24

# Cloudflare
CLOUDFLARE_API_TOKEN=<YOUR_CLOUDFLARE_API_TOKEN>
CLOUDFLARE_ZONE_ID=<YOUR_CLOUDFLARE_ZONE_ID>
CLOUDFLARE_ACTION=block

# AWS WAF
AWS_REGION=us-east-1
AWS_WEB_ACL_ID=<YOUR_AWS_WAF_WEB_ACL_ID>
AWS_RULE_GROUP_ID=
AWS_WAF_ACTION=block

# ─── Celery Configuration (Worker) ─────────────────────────────────
API_BASE_URL=http://localhost:8000
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ─── AI Features ───────────────────────────────────────────────────
AI_SUMMARIZE_ENABLED=true

# ─── Cache Configuration ───────────────────────────────────────────
CACHE_TTL_SECONDS=3600
