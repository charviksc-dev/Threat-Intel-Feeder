#!/usr/bin/expect -f
set timeout 30

set files {
    "services/api/app/services/ai_engine.py"
    "services/api/app/routes/search.py"
}

foreach file $files {
    spawn scp -o StrictHostKeyChecking=no $file innopay@10.81.20.148:~/neev-tip/$file
    expect {
        "assword:" {
            send "Innopay@123\r"
            exp_continue
        }
        eof
    }
}
